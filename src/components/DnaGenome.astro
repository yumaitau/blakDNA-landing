---
const features = [
  { title: "Know your connections", label: "Security Genome", text: "Identities, workloads, privileges and controls. One connected understanding of your organisation.", href: "/security-genome/", link: "Explore the genome" },
  { title: "Sense dangerous change", label: "Mutations", text: "A new permission can open a route into production. Separate ordinary change from material risk.", href: "/product/#screen-06-critical-risk", link: "See a dangerous mutation" },
  { title: "Trace what an attacker can reach", label: "Attack paths", text: "Follow relationships from an exposed entry point to the systems and data that matter.", href: "/attack-path-analysis/", link: "Follow an attack path" },
  { title: "Verify the fix", label: "Immune response", text: "A closed ticket is not proof. Observe the environment again and confirm the path is gone.", href: "/product/#screen-09-verified-remediation", link: "See verified remediation" },
  { title: "Learn from experience", label: "Adaptive immunity", text: "Turn evidence and human decisions into memory. Evaluate learned antibodies before activation.", href: "/product/#screen-10-adaptive-immunity", link: "See adaptive immunity" },
  { title: "Remember what returns", label: "Immune memory", text: "Recognise a previously resolved weakness when it reappears. Familiar never means safe.", href: "/product/#screen-12-recurrence", link: "See a returning weakness" },
];
---
<section id="living-genome" class="dna-section" aria-labelledby="dna-title">
  <div class="container">
    <header><p class="eyebrow">Your organisation. A living Security Genome.</p><h2 id="dna-title">Resilience is in<br />the connections.</h2><p>Not a collection of alerts. A growing understanding of how your organisation changes, where risk develops, and what makes it stronger.</p></header>
    <div class="dna-explorer">
      <div class="dna-stage">
        <img class="dna-poster" src="/images/security-genome.png" width="1536" height="1024" loading="lazy" decoding="async" alt="" />
        <canvas aria-hidden="true"></canvas>
      </div>
      <div class="dna-callouts">
        {features.map((feature, index) => <details class="dna-feature" name="genome-feature" open={index === 0}>
          <summary><span class="dna-label">{feature.label}</span><span class="dna-feature-title">{feature.title}</span></summary>
          <div class="dna-feature-body"><p>{feature.text}</p><a href={feature.href}>{feature.link} <span aria-hidden="true">↗</span></a></div>
        </details>)}
      </div>
      <div class="dna-controls" hidden>
        <p>Drag to rotate. Select a connection to explore.</p>
        <div><button type="button" class="dna-play" aria-pressed="false">Play animation</button><label for="dna-rotation">Rotate DNA</label><input id="dna-rotation" type="range" min="0" max="360" value="35" aria-label="Rotate DNA" /></div>
      </div>
      <p class="dna-caption">An interactive illustration of connected cyber understanding. Not live organisational telemetry.</p>
    </div>
  </div>
</section>
<script>
  import { initializeGenome } from "../scripts/dna-genome";
  document.querySelectorAll<HTMLElement>(".dna-explorer").forEach(initializeGenome);
</script>
<style>
  .dna-section { background: #101210; color: #f4f0e9; padding-block: 64px 36px; scroll-margin-top: 78px; }
  header { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 60px; align-items: end; }
  header .eyebrow { grid-column: 1 / -1; color: #edb88e; }
  header h2 { font-size: clamp(34px, 4.2vw, 60px); }
  header > p:not(.eyebrow) { color: #c2c8be; font-size: 18px; max-width: 46ch; padding-bottom: 4px; }
  .dna-explorer { position: relative; margin-top: 24px; }
  .dna-stage { position: relative; height: 620px; overflow: hidden; background: radial-gradient(ellipse at center, #22221b 0%, #101210 64%); }
  .dna-poster { width: 100%; height: 100%; object-fit: cover; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; cursor: grab; visibility: hidden; }
  canvas:active { cursor: grabbing; }
  .dna-explorer[data-ready] canvas { visibility: visible; }
  .dna-explorer[data-ready] .dna-poster { visibility: hidden; }
  .dna-callouts { position: absolute; top: 48px; inset-inline: 0; height: 534px; display: grid; grid-template-columns: 1fr 1.3fr 1fr; grid-template-rows: repeat(3, 1fr); gap: 0 18px; pointer-events: none; }
  .dna-feature { border: 0; padding: 0; margin: 0; align-self: start; pointer-events: auto; color: #f4f0e9; background: #101210; }
  .dna-feature:nth-child(odd) { grid-column: 1; }
  .dna-feature:nth-child(even) { grid-column: 3; }
  .dna-feature:nth-child(-n+2) { grid-row: 1; }
  .dna-feature:nth-child(n+3):nth-child(-n+4) { grid-row: 2; }
  .dna-feature:nth-child(n+5) { grid-row: 3; }
  summary { display: block; list-style: none; cursor: pointer; padding: 10px 0 12px; border-top: 1px solid #55604f; min-height: 72px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; float: right; color: #edb88e; font-size: 20px; }
  details[open] summary::after { content: "−"; }
  summary:hover, details[open] summary { border-color: #edb88e; }
  .dna-label { display: block; color: #edb88e; font-size: 11px; text-transform: uppercase; letter-spacing: .13em; margin-bottom: 8px; }
  .dna-feature-title { font-size: 18px; line-height: 1.3; }
  .dna-feature-body p { color: #c2c8be; font-size: 14px; line-height: 1.5; margin: 0 0 10px; }
  .dna-feature-body a { color: #f1bd91; font-size: 13px; }
  .dna-controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; padding-block: 18px; border-top: 1px solid #41483e; }
  .dna-controls[hidden] { display: none; }
  .dna-controls p, .dna-controls label { color: #c2c8be; font-size: 13px; }
  .dna-controls > div { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .dna-play { background: transparent; border: 1px solid #76826f; border-radius: 30px; color: #f4f0e9; font: inherit; font-size: 13px; min-height: 44px; padding: 8px 18px; cursor: pointer; }
  input { accent-color: #edb88e; width: 112px; min-height: 44px; }
  .dna-caption { color: #a9b3a4; font-size: 12px; padding-block: 4px; }
  summary:focus-visible, a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid #ffe0b8; outline-offset: 5px; }
  @media (max-width: 800px) {
    header { grid-template-columns: 1fr; gap: 20px; }
    .dna-section { padding-block: 40px 28px; }
    .dna-stage { height: 410px; }
    .dna-poster { object-fit: cover; width: 160%; max-width: none; margin-left: -30%; }
    .dna-callouts { position: relative; top: auto; height: auto; grid-template-columns: 1fr 1fr; grid-template-rows: auto; gap: 20px; }
    .dna-feature:nth-child(n) { grid-column: auto; grid-row: auto; }
    .dna-feature-title { font-size: 16px; }
    .dna-controls { margin-top: 24px; }
    .dna-controls > div { gap: 10px; }
  }
  @media (max-width: 360px) { .dna-callouts { grid-template-columns: 1fr; } }
</style>
