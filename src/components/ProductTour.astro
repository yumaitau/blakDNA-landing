---
import { productTour } from "../data/product-tour";
import dimensions from "../data/product-screenshot-dimensions.json";
import ImageViewer from "./ImageViewer.astro";
---
<section id="product-tour" class="product-tour" aria-labelledby="tour-title">
  <header><p class="eyebrow">From dangerous change to stronger immunity</p><h2 id="tour-title">See the risk.<br />Prove the recovery.</h2><p>One new permission. A path into production. Follow how blakDNA explains the danger, remembers the response, verifies the fix, and recognises the pattern next time.</p><p class="caption">Actual product, synthetic organisation. Illustrative AWS observations and deterministic test reasoning; not customer telemetry or production deployment proof.</p></header>
  <nav aria-label="Product tour chapters">{productTour.map((item) => <a href={`#screen-${item.name}`}>{item.title}</a>)}</nav>
  {productTour.map((item) => {
    const preview = `${item.name}${item.detail ? "-detail" : ""}.png`;
    const size = dimensions[preview as keyof typeof dimensions];
    const mobileSize = dimensions[`mobile/${preview}` as keyof typeof dimensions];
    return <article id={`screen-${item.name}`} class="tour-chapter">
      <h3>{item.title}</h3><p>{item.description}</p>
      <figure><a data-image-viewer data-adaptive-image data-title={item.title} href={`/images/product/desktop/${preview}`} aria-label={`Open product detail: ${item.title}`}><picture><source media="(max-width: 600px)" srcset={`/images/product/mobile/${preview}`} width={mobileSize.width} height={mobileSize.height} /><img src={`/images/product/desktop/${preview}`} width={size.width} height={size.height} loading="lazy" decoding="async" alt={`${item.title}: actual blakDNA browser capture using a synthetic organisation.`} /></picture></a><figcaption><a data-image-viewer data-title={item.title} href={`/images/product/desktop/${preview}`}>Desktop detail</a> · <a data-image-viewer data-title={item.title} href={`/images/product/mobile/${preview}`}>Mobile detail</a></figcaption></figure>
    </article>;
  })}
</section>
<ImageViewer />
<style>
  .product-tour { padding-block: 32px 64px; border-top: 1px solid var(--line); }
  header p:not(.eyebrow) { margin-top: 24px; }
  nav { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-block: 32px 56px; font-size: 15px; }
  .tour-chapter { margin-block: 48px 72px; scroll-margin-top: 110px; }
  .tour-chapter > p { margin-block: 18px 24px; }
  figure { padding: 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  img { display: block; width: 100%; height: auto; background: #0b0c0b; }
  figcaption { padding: 16px 8px 6px; font-size: 14px; color: var(--muted); }
  @media (max-width: 600px) { figure { padding: 5px; } figcaption { font-size: 13px; } }
</style>
